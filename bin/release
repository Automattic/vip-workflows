#!/bin/sh

set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
	printf 'Usage: %s <major|minor|patch|none> [stable|alpha|beta]\n' "$0" >&2
	exit 1
fi

release_type=$1
release_channel=${2:-stable}
php_file="vip-workflows/vip-workflows.php"
package_file="vip-workflows/package.json"
lock_file="vip-workflows/package-lock.json"

current_version=$(sed -n 's/.*Version: *//p' "$php_file" | head -n 1 | tr -d '[:space:]')
new_version=$(node tools/release/version.mjs "$current_version" "$release_type" "$release_channel")

node - "$current_version" "$package_file" "$lock_file" <<'NODE'
const fs = require( 'fs' );

const [ expectedVersion, packageFile, lockFile ] = process.argv.slice( 2 );
const packageJson = JSON.parse( fs.readFileSync( packageFile, 'utf8' ) );
const packageLock = JSON.parse( fs.readFileSync( lockFile, 'utf8' ) );
const versions = {
	[ packageFile ]: packageJson.version,
	[ lockFile ]: packageLock.version,
	[ `${ lockFile } packages[""]` ]: packageLock.packages?.['']?.version,
};

for ( const [ source, version ] of Object.entries( versions ) ) {
	if ( version !== expectedVersion ) {
		throw new Error(
			`${ source } has version ${ version }, expected ${ expectedVersion }`
		);
	}
}
NODE

tmp_file="${php_file}.tmp.$$"
sed \
	-e "s/Version: $current_version/Version: $new_version/" \
	-e "s/define( 'VIP_WORKFLOWS_VERSION', '$current_version' );/define( 'VIP_WORKFLOWS_VERSION', '$new_version' );/" \
	"$php_file" > "$tmp_file"
mv "$tmp_file" "$php_file"

npm --prefix vip-workflows version "$new_version" --no-git-tag-version

branch="release/v$new_version"
git checkout -b "$branch"
git add "$php_file" "$package_file" "$lock_file"
git commit -m "v$new_version"

printf 'Prepared %s on %s.\n' "$new_version" "$branch"
