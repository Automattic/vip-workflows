{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/wp-env.json",
	"core": "WordPress/WordPress#master",
	"phpVersion": "8.2",
	"plugins": [
		"https://downloads.wordpress.org/plugin/gutenberg.zip",
		"https://github.com/WordPress/mcp-adapter/releases/latest/download/mcp-adapter.zip",
		"https://downloads.wordpress.org/plugin/wp-parsely.zip",
		"./vip-workflow",
		"./workflow-parsely",
		"./workflow-tool-checklist",
		"./workflow-assistant-wikipedia",
		"./workflow-agent-copy-edit",
		"./workflow-agent-tag-sanity-check"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"mappings": {
		"wp-env-tools": "./tools"
	},
	"lifecycleScripts": {
		"afterStart": "bash tools/wp-env-after-start.sh"
	},
	"testsEnvironment": false
}
