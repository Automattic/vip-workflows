{
	"name": "vip-workflow-monorepo",
	"private": true,
	"description": "Root orchestration for the VIP Workflow plugin and its extensions.",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
		"postinstall": "node scripts/patch-wp-env.js",
		"setup": "npm install && run-s setup:npm setup:composer",
		"setup:npm": "run-s setup:npm:*",
		"setup:npm:vip-workflow": "npm --prefix vip-workflow install",
		"setup:npm:checklist": "npm --prefix workflow-tool-checklist install",
		"setup:composer": "run-s setup:composer:*",
		"build": "run-p build:*",
		"build:vip-workflow": "npm --prefix vip-workflow run build",
		"build:checklist": "npm --prefix workflow-tool-checklist run build",
		"watch": "run-p watch:*",
		"watch:vip-workflow": "npm --prefix vip-workflow run start",
		"watch:checklist": "npm --prefix workflow-tool-checklist run start",
		"dev": "trap 'npm run wp-env:stop:tests; npm run wp-env:stop' EXIT INT TERM; run-s wp-env:start wp-env:start:tests watch",
		"lint": "node tools/code-quality/quality.mjs lint --all",
		"lint:all": "node tools/code-quality/quality.mjs lint --all",
		"lint:changed": "node tools/code-quality/quality.mjs lint --changed",
		"test:unit": "node tools/code-quality/quality.mjs test --all",
		"test:all": "node tools/code-quality/quality.mjs test --all",
		"test:unit:changed": "node tools/code-quality/quality.mjs test --changed",
		"test:tools": "node --test tools/*/*.test.mjs",
		"check": "node tools/code-quality/quality.mjs check --changed",
		"check:all": "node tools/code-quality/quality.mjs check --all",
		"fix": "node tools/code-quality/quality.mjs fix --changed",
		"fix:all": "node tools/code-quality/quality.mjs fix --all",
		"suppressions": "node tools/code-quality/quality.mjs suppressions",
		"test:php:integration": "node scripts/run-integration-suites.mjs",
		"test:php:integration:teardown": "wp-env run cli --config .wp-env.tests.json wp db query \"DROP DATABASE IF EXISTS wordpress_test\"",
		"lint:wp-env-config": "node scripts/gen-wp-env-tests.js --check",
		"wp-env": "wp-env",
		"prewp-env:start": "node scripts/check-dev-no-http-block.js",
		"wp-env:start": "wp-env start",
		"wp-env:stop": "wp-env stop",
		"prewp-env:start:tests": "node scripts/gen-wp-env-tests.js",
		"wp-env:start:tests": "wp-env start --config .wp-env.tests.json",
		"wp-env:stop:tests": "wp-env stop --config .wp-env.tests.json",
		"wp-env:destroy": "wp-env destroy",
		"wp-env:clean": "wp-env clean all",
		"wp-env:logs": "wp-env logs --debug",
		"setup:composer:vip-workflow": "composer --working-dir=vip-workflow install",
		"setup:composer:parsely": "composer --working-dir=workflow-parsely install"
	},
	"devDependencies": {
		"@wordpress/env": "^11.0.0",
		"npm-run-all": "^4.1.5"
	},
	"overrides": {
		"adm-zip": "^0.6.0"
	}
}
