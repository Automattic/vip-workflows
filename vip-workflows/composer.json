{
	"name": "vip-workflows/vip-workflows",
	"description": "Editorial workflow management for WordPress",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"minimum-stability": "RC",
	"prefer-stable": true,
	"require": {
		"php": ">=8.2",
		"woocommerce/action-scheduler": "^3.7",
		"wordpress/openai-ai-provider": "^1.0",
		"smalot/pdfparser": "^2.12"
	},
	"replace": {
		"wordpress/php-ai-client": "*",
		"psr/event-dispatcher": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"yoast/wp-test-utils": "^1.2",
		"yoast/phpunit-polyfills": "^1.1.5",
		"automattic/vipwpcs": "^3.0",
		"wp-coding-standards/wpcs": "^3.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"VIPWorkflow\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"cs": "phpcs",
		"cbf": "phpcbf",
		"test": "@test:unit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration",
		"test:coverage": "phpunit --testsuite unit --coverage-html coverage"
	},
	"config": {
		"platform": {
			"php": "8.2.0"
		},
		"allow-plugins": {
			"composer/installers": true,
			"php-http/discovery": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
