<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Workflow: Parse.ly">
	<description>Sniffs for the workflow-parsely bridge plugin, mirroring vip-workflows's ruleset.</description>

	<file>.</file>

	<!-- Matches vip-workflows's ruleset: test files are excluded, so PHPUnit's
		naming and docblock conventions don't fight WordPress-Docs. -->
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="WordPress-Extra"/> <!-- Includes WordPress-Core -->
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-VIP-Go"/>

	<!-- Namespaced PascalCase class names with a composer classmap, matching
		vip-workflows. Renaming for WPCS Snake_Case would break autoloading for
		no platform benefit. -->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<config name="minimum_supported_wp_version" value="7.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="workflow-parsely"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.2-"/>
</ruleset>
